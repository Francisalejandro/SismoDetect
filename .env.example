# Copia este archivo como .env y completa los valores.
# No subas .env al repositorio.

DJANGO_SECRET_KEY=cambiar-por-una-clave-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

